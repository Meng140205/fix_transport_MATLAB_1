<sdf version='1.9'>
  <model name='transport_rod'>
    <link name='rod'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.14999999999999999</mass>
        <inertia>
          <ixx>2.2500000000000001e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018011249999999999</iyy>
          <iyz>0</iyz>
          <izz>0.018011249999999999</izz>
        </inertia>
      </inertial>
      <collision name='rod_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.2 0.03 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name='rod_visual'>
